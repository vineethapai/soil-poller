# Connection string WITH password. Get it from:
#   tiger db connection-string --service-id kw1l0wge3t --with-password
DATABASE_URL=postgresql://tsdbadmin:PASSWORD@kw1l0wge3t.m1wd7awm5i.tsdb.cloud.timescale.com:35637/tsdb?sslmode=require

# How often to poll (Go duration: 30s, 5m, 1h). Default: 5m
POLL_INTERVAL=5m

# Alert when a device's latest moisture is below this percentage. Default: 25
MOISTURE_THRESHOLD=25

# Optional: Slack incoming webhook URL. If unset, the poller only logs to stdout.
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ

# If true (default), only post to Slack when there are alerts. Set false to get
# an "all clear" message every poll.
SLACK_ALERT_ONLY=true
